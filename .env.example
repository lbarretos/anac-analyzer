# ETL (GitHub Actions / execução local): role com permissão de escrita.
# Nunca expor no frontend nem em variáveis NEXT_PUBLIC_*.
DATABASE_URL=postgresql://etl_user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Frontend Next.js (API routes, server-side): use um role SOMENTE LEITURA
# (GRANT SELECT apenas nas tabelas/views consultadas pelas rotas /api/*).
# Se ausente, o app usa DATABASE_URL (com permissão de escrita; não recomendado).
DATABASE_URL_READONLY=postgresql://readonly_user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
